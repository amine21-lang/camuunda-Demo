<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:formio="http://socgen.com/schema/bpmn/formio" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CreationProfilTrader" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">

  <bpmn2:process id="Process_CreationProfilTrader" name="Création profil on behalf du trader" processType="None" isClosed="false" isExecutable="true" camunda:historyTimeToLive="P7D">

    <!-- ===================== DEMARRAGE ===================== -->

    <bpmn2:startEvent id="StartEvent_Request" name="Requête reçue (API externe)">
      <bpmn2:documentation>Démarré par l'API externe via REST avec les variables : idRequest, traderFirstName, traderLastName et marketId (OBLIGATOIRE : "4" ou "948"). Le nom du marché (marketName) est déduit du marketId dans chaque chemin. Idéalement, l'API passe aussi businessKey = idRequest dans la requête de démarrage. Variables de test optionnelles : testMode, testIntervalSeconds.</bpmn2:documentation>
      <bpmn2:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript"><![CDATA[
// ---- Initialisation : business key + valeurs par défaut (ne remplace jamais une variable déjà fournie) ----
var id = execution.getVariable('idRequest');
if (id == null) { id = 'REQ-' + new Date().getTime(); execution.setVariable('idRequest', id); }
if (execution.getProcessBusinessKey() == null) {
  try { execution.setBusinessKey(String(id)); } catch (e) { /* non bloquant : passer businessKey dans la requête de démarrage */ }
}

// ---- marketId fourni par le service externe : normalisé en texte ('' si absent) pour que la gateway de routage ne plante jamais ----
var m = execution.getVariable('marketId');
execution.setVariable('marketId', m == null ? '' : String(m).replace(/^\s+|\s+$/g, ''));

function def(n, v) { if (execution.getVariable(n) == null) { execution.setVariable(n, v); } }
def('testMode', false);                 // true = timers raccourcis (voir testIntervalSeconds)
def('testIntervalSeconds', 30);         // en mode test : 1 "jour ouvré" = 30 secondes
def('maxDays', 5);                      // durée de validité du lien marché (jours ouvrés)
def('reminderCount', 0);
def('apiBaseUrl', 'https://webhook.site/REMPLACER-PAR-VOTRE-UUID');   // URL du service externe (ou d'un mock)
def('appBaseUrl', 'https://REMPLACER-PAR-URL-INTERFACE');             // base des liens dans les emails
def('teamEmails', 'equipe-test@exemple.com');
def('traderEmail', 'trader-test@exemple.com');
def('teamGroup', 'market-access-team');  // groupe candidat des tâches équipe
def('traderUserId', 'demo');             // assignee de la tâche trader

execution.setVariable('procInstId', execution.getProcessInstanceId());
]]></camunda:script>
        </camunda:executionListener>
        <formio:form />
      </bpmn2:extensionElements>
      <bpmn2:outgoing>Flow_Start_Market</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:exclusiveGateway id="Gateway_Market" name="marketId ?" default="Flow_Market_Unsupported">
      <bpmn2:documentation>Aiguillage selon le marketId fourni par le service externe : 4 ou 948. Toute autre valeur (ou absence) part vers la fin "Marché non supporté".</bpmn2:documentation>
      <bpmn2:incoming>Flow_Start_Market</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Market_M4</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Market_M948</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Market_Unsupported</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:endEvent id="End_UnsupportedMarket" name="Marché non supporté (4 ou 948 attendus)">
      <bpmn2:documentation>marketId absent ou différent de 4 / 948 : le workflow s'arrête sans email ni tâche. Ajouter ici une notification API si le service externe doit être prévenu.</bpmn2:documentation>
      <bpmn2:incoming>Flow_Market_Unsupported</bpmn2:incoming>
    </bpmn2:endEvent>

    <!-- ===================== PHASE 1 : EQUIPE — CHEMIN MARCHE 4 ===================== -->

    <bpmn2:scriptTask id="ScriptTask_EmailTeam_M4" name="Email à l'équipe (marché 4)" scriptFormat="javascript">
      <bpmn2:documentation>SIMULATION : écrit l'email dans emailLog. A remplacer par le mécanisme d'envoi d'email de l'outil SG. Définit marketName à partir du marketId (4). Remplacer le libellé ci-dessous par le vrai nom du marché.</bpmn2:documentation>
      <bpmn2:incoming>Flow_Market_M4</bpmn2:incoming>
      <bpmn2:outgoing>Flow_EmailM4_Task</bpmn2:outgoing>
      <bpmn2:script><![CDATA[
function v(n) { var x = execution.getVariable(n); return x == null ? '' : String(x); }
function logEmail(to, subject, body) {
  var l = execution.getVariable('emailLog');
  l = (l == null ? '' : String(l) + '\n-----\n') + 'TO: ' + to + '\nSUBJECT: ' + subject + '\n' + body;
  execution.setVariable('emailLog', l);
}
// Nom du marché déduit du marketId (4) -> A REMPLACER par le vrai nom
execution.setVariable('marketName', 'Marché 4');

var url = v('appBaseUrl') + '/team/' + v('procInstId');
execution.setVariable('teamTaskUrl', url);
logEmail(v('teamEmails'),
  '[Action requise] Création de profil on behalf - ' + v('marketName') + ' - ' + v('idRequest'),
  'Trader : ' + v('traderFirstName') + ' ' + v('traderLastName') + '\nMarché : ' + v('marketName') + ' (' + v('marketId') + ')\nTraiter la demande : ' + url);
]]></bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:userTask id="UserTask_TraiterDemande_M4" name="Traiter la demande (Assign to me) - ${marketName}" camunda:candidateGroups="${teamGroup}">
      <bpmn2:documentation>Interface équipe (marché 4). Afficher le nom du marché (variable marketName) et les étapes propres à ce marché. Le bouton "Assign to me" = claim de la tâche (un seul opérateur). Le formulaire doit contenir la case obligatoire "I confirm that I create the profile on behalf" (variable booléenne confirmOnBehalf) et le bouton Submit.</bpmn2:documentation>
      <bpmn2:extensionElements>
        <formio:form />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_EmailM4_Task</bpmn2:incoming>
      <bpmn2:incoming>Flow_ConfirmM4_No</bpmn2:incoming>
      <bpmn2:outgoing>Flow_TaskM4_Confirm</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:exclusiveGateway id="Gateway_Confirm_M4" name="Confirmation cochée ?" default="Flow_ConfirmM4_No">
      <bpmn2:incoming>Flow_TaskM4_Confirm</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ConfirmM4_Yes</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_ConfirmM4_No</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <!-- ===================== PHASE 1 : EQUIPE — CHEMIN MARCHE 948 ===================== -->

    <bpmn2:scriptTask id="ScriptTask_EmailTeam_M948" name="Email à l'équipe (marché 948)" scriptFormat="javascript">
      <bpmn2:documentation>SIMULATION : écrit l'email dans emailLog. A remplacer par le mécanisme d'envoi d'email de l'outil SG. Définit marketName à partir du marketId (948). Remplacer le libellé ci-dessous par le vrai nom du marché.</bpmn2:documentation>
      <bpmn2:incoming>Flow_Market_M948</bpmn2:incoming>
      <bpmn2:outgoing>Flow_EmailM948_Task</bpmn2:outgoing>
      <bpmn2:script><![CDATA[
function v(n) { var x = execution.getVariable(n); return x == null ? '' : String(x); }
function logEmail(to, subject, body) {
  var l = execution.getVariable('emailLog');
  l = (l == null ? '' : String(l) + '\n-----\n') + 'TO: ' + to + '\nSUBJECT: ' + subject + '\n' + body;
  execution.setVariable('emailLog', l);
}
// Nom du marché déduit du marketId (948) -> A REMPLACER par le vrai nom
execution.setVariable('marketName', 'Marché 948');

var url = v('appBaseUrl') + '/team/' + v('procInstId');
execution.setVariable('teamTaskUrl', url);
logEmail(v('teamEmails'),
  '[Action requise] Création de profil on behalf - ' + v('marketName') + ' - ' + v('idRequest'),
  'Trader : ' + v('traderFirstName') + ' ' + v('traderLastName') + '\nMarché : ' + v('marketName') + ' (' + v('marketId') + ')\nTraiter la demande : ' + url);
]]></bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:userTask id="UserTask_TraiterDemande_M948" name="Traiter la demande (Assign to me) - ${marketName}" camunda:candidateGroups="${teamGroup}">
      <bpmn2:documentation>Interface équipe (marché 948). Afficher le nom du marché (variable marketName) et les étapes propres à ce marché. Le bouton "Assign to me" = claim de la tâche (un seul opérateur). Le formulaire doit contenir la case obligatoire "I confirm that I create the profile on behalf" (variable booléenne confirmOnBehalf) et le bouton Submit.</bpmn2:documentation>
      <bpmn2:extensionElements>
        <formio:form />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_EmailM948_Task</bpmn2:incoming>
      <bpmn2:incoming>Flow_ConfirmM948_No</bpmn2:incoming>
      <bpmn2:outgoing>Flow_TaskM948_Confirm</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:exclusiveGateway id="Gateway_Confirm_M948" name="Confirmation cochée ?" default="Flow_ConfirmM948_No">
      <bpmn2:incoming>Flow_TaskM948_Confirm</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ConfirmM948_Yes</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_ConfirmM948_No</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <!-- ===================== FUSION DES DEUX CHEMINS ===================== -->

    <bpmn2:exclusiveGateway id="Gateway_Merge" name="Fusion des marchés">
      <bpmn2:incoming>Flow_ConfirmM4_Yes</bpmn2:incoming>
      <bpmn2:incoming>Flow_ConfirmM948_Yes</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Merge_Status</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:serviceTask id="ServiceTask_StatusWaitingTrader" name="API : statut → WAITING_TRADER" camunda:asyncBefore="true">
      <bpmn2:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">${apiBaseUrl}/requests/${idRequest}/status</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{"idRequest":"${idRequest}","status":"WAITING_TRADER"}</camunda:inputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Merge_Status</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Status_EmailTrader</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <!-- ===================== PHASE 2 : TRADER ===================== -->

    <bpmn2:scriptTask id="ScriptTask_EmailTrader" name="Email au trader" scriptFormat="javascript">
      <bpmn2:documentation>SIMULATION : écrit l'email dans emailLog. Calcule la date d'expiration (maxDays jours ouvrés) et la date du premier rappel.</bpmn2:documentation>
      <bpmn2:incoming>Flow_Status_EmailTrader</bpmn2:incoming>
      <bpmn2:outgoing>Flow_EmailTrader_Sub</bpmn2:outgoing>
      <bpmn2:script><![CDATA[
function v(n) { var x = execution.getVariable(n); return x == null ? '' : String(x); }
function logEmail(to, subject, body) {
  var l = execution.getVariable('emailLog');
  l = (l == null ? '' : String(l) + '\n-----\n') + 'TO: ' + to + '\nSUBJECT: ' + subject + '\n' + body;
  execution.setVariable('emailLog', l);
}
// Prochain "jour" : jour ouvré suivant (lun-ven), ou +testIntervalSeconds en mode test
function step(d) {
  if (String(execution.getVariable('testMode')) == 'true') {
    return new Date(d.getTime() + Number(execution.getVariable('testIntervalSeconds')) * 1000);
  }
  var x = new Date(d.getTime());
  do { x = new Date(x.getTime() + 86400000); } while (x.getDay() == 0 || x.getDay() == 6);
  return x;
}
function iso(d) { return d.toISOString().split('.')[0] + 'Z'; }

var now = new Date();
var expiry = now;
for (var i = 0; i < Number(execution.getVariable('maxDays')); i++) { expiry = step(expiry); }
execution.setVariable('expiryDate', iso(expiry));
execution.setVariable('nextReminderDate', iso(step(now)));
execution.setVariable('reminderCount', 0);

var url = v('appBaseUrl') + '/trader/' + v('procInstId');
execution.setVariable('traderTaskUrl', url);
logEmail(v('traderEmail'),
  'Action requise : finaliser la création de votre profil - ' + v('marketName'),
  'Le marché vous a fourni un lien valable ' + v('maxDays') + ' jours (jusqu\'au ' + iso(expiry) + ').\nDémarche et confirmation : ' + url);
]]></bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:subProcess id="SubProcess_AttenteTrader" name="Attente du trader (confirmation ou expiration)">
      <bpmn2:incoming>Flow_EmailTrader_Sub</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Sub_StatusFinal</bpmn2:outgoing>

      <bpmn2:startEvent id="SubStart" name="Début attente">
        <bpmn2:outgoing>S_Start_Fork</bpmn2:outgoing>
      </bpmn2:startEvent>

      <bpmn2:parallelGateway id="Gateway_Fork" name="Confirmation || Rappels">
        <bpmn2:incoming>S_Start_Fork</bpmn2:incoming>
        <bpmn2:outgoing>S_Fork_Confirm</bpmn2:outgoing>
        <bpmn2:outgoing>S_Fork_Timer</bpmn2:outgoing>
      </bpmn2:parallelGateway>

      <!-- Branche A : confirmation du trader -->
      <bpmn2:userTask id="UserTask_ConfirmTrader" name="Confirmation du compte par le trader" camunda:assignee="${traderUserId}">
        <bpmn2:documentation>Interface trader : démarche + bouton "Je confirme la confirmation de mon compte" (variable traderConfirmed).</bpmn2:documentation>
        <bpmn2:extensionElements>
          <formio:form />
        </bpmn2:extensionElements>
        <bpmn2:incoming>S_Fork_Confirm</bpmn2:incoming>
        <bpmn2:outgoing>S_Confirm_Mark</bpmn2:outgoing>
      </bpmn2:userTask>

      <bpmn2:scriptTask id="ScriptTask_MarkConfirmed" name="Marquer COMPLETED" scriptFormat="javascript">
        <bpmn2:incoming>S_Confirm_Mark</bpmn2:incoming>
        <bpmn2:outgoing>S_Mark_End</bpmn2:outgoing>
        <bpmn2:script><![CDATA[
execution.setVariable('outcome', 'COMPLETED');
]]></bpmn2:script>
      </bpmn2:scriptTask>

      <bpmn2:endEvent id="End_TermConfirmed" name="Confirmé (stoppe les rappels)">
        <bpmn2:incoming>S_Mark_End</bpmn2:incoming>
        <bpmn2:terminateEventDefinition id="TerminateDef_Confirmed" />
      </bpmn2:endEvent>

      <!-- Branche B : rappels quotidiens (jours ouvrés) -->
      <bpmn2:intermediateCatchEvent id="Timer_NextReminder" name="Prochain jour ouvré">
        <bpmn2:incoming>S_Fork_Timer</bpmn2:incoming>
        <bpmn2:incoming>S_Reminder_Timer</bpmn2:incoming>
        <bpmn2:outgoing>S_Timer_Count</bpmn2:outgoing>
        <bpmn2:timerEventDefinition id="TimerDef_NextReminder">
          <bpmn2:timeDate xsi:type="bpmn2:tFormalExpression">${nextReminderDate}</bpmn2:timeDate>
        </bpmn2:timerEventDefinition>
      </bpmn2:intermediateCatchEvent>

      <bpmn2:scriptTask id="ScriptTask_Count" name="Compter le jour" scriptFormat="javascript">
        <bpmn2:incoming>S_Timer_Count</bpmn2:incoming>
        <bpmn2:outgoing>S_Count_GwMore</bpmn2:outgoing>
        <bpmn2:script><![CDATA[
execution.setVariable('reminderCount', Number(execution.getVariable('reminderCount')) + 1);
]]></bpmn2:script>
      </bpmn2:scriptTask>

      <bpmn2:exclusiveGateway id="Gateway_More" name="Il reste des rappels ?" default="S_GwMore_Final">
        <bpmn2:incoming>S_Count_GwMore</bpmn2:incoming>
        <bpmn2:outgoing>S_GwMore_Reminder</bpmn2:outgoing>
        <bpmn2:outgoing>S_GwMore_Final</bpmn2:outgoing>
      </bpmn2:exclusiveGateway>

      <bpmn2:scriptTask id="ScriptTask_SendReminder" name="Email de rappel" scriptFormat="javascript">
        <bpmn2:documentation>SIMULATION : écrit le rappel dans emailLog et programme le prochain jour ouvré.</bpmn2:documentation>
        <bpmn2:incoming>S_GwMore_Reminder</bpmn2:incoming>
        <bpmn2:outgoing>S_Reminder_Timer</bpmn2:outgoing>
        <bpmn2:script><![CDATA[
function v(n) { var x = execution.getVariable(n); return x == null ? '' : String(x); }
function logEmail(to, subject, body) {
  var l = execution.getVariable('emailLog');
  l = (l == null ? '' : String(l) + '\n-----\n') + 'TO: ' + to + '\nSUBJECT: ' + subject + '\n' + body;
  execution.setVariable('emailLog', l);
}
function step(d) {
  if (String(execution.getVariable('testMode')) == 'true') {
    return new Date(d.getTime() + Number(execution.getVariable('testIntervalSeconds')) * 1000);
  }
  var x = new Date(d.getTime());
  do { x = new Date(x.getTime() + 86400000); } while (x.getDay() == 0 || x.getDay() == 6);
  return x;
}
function iso(d) { return d.toISOString().split('.')[0] + 'Z'; }

var left = Number(execution.getVariable('maxDays')) - Number(execution.getVariable('reminderCount'));
logEmail(v('traderEmail'),
  'Rappel : finalisez la création de votre profil - ' + v('marketName'),
  'Rappel ' + v('reminderCount') + '/' + (Number(execution.getVariable('maxDays')) - 1) + '. Il vous reste ' + left + ' jour(s) ouvré(s) avant expiration du lien.\nDémarche et confirmation : ' + v('traderTaskUrl'));
execution.setVariable('nextReminderDate', iso(step(new Date())));
]]></bpmn2:script>
      </bpmn2:scriptTask>

      <bpmn2:scriptTask id="ScriptTask_SendFinal" name="Email final : lien expiré" scriptFormat="javascript">
        <bpmn2:documentation>SIMULATION : écrit l'email final dans emailLog et marque EXPIRED.</bpmn2:documentation>
        <bpmn2:incoming>S_GwMore_Final</bpmn2:incoming>
        <bpmn2:outgoing>S_Final_End</bpmn2:outgoing>
        <bpmn2:script><![CDATA[
function v(n) { var x = execution.getVariable(n); return x == null ? '' : String(x); }
function logEmail(to, subject, body) {
  var l = execution.getVariable('emailLog');
  l = (l == null ? '' : String(l) + '\n-----\n') + 'TO: ' + to + '\nSUBJECT: ' + subject + '\n' + body;
  execution.setVariable('emailLog', l);
}
logEmail(v('traderEmail'),
  'Lien expiré : veuillez recréer la demande - ' + v('marketName'),
  'Le lien fourni par le marché a expiré. Merci de recréer la demande (réf. ' + v('idRequest') + ').');
execution.setVariable('outcome', 'EXPIRED');
]]></bpmn2:script>
      </bpmn2:scriptTask>

      <bpmn2:endEvent id="End_TermExpired" name="Expiré (stoppe la tâche trader)">
        <bpmn2:incoming>S_Final_End</bpmn2:incoming>
        <bpmn2:terminateEventDefinition id="TerminateDef_Expired" />
      </bpmn2:endEvent>

      <bpmn2:sequenceFlow id="S_Start_Fork" sourceRef="SubStart" targetRef="Gateway_Fork" />
      <bpmn2:sequenceFlow id="S_Fork_Confirm" sourceRef="Gateway_Fork" targetRef="UserTask_ConfirmTrader" />
      <bpmn2:sequenceFlow id="S_Fork_Timer" sourceRef="Gateway_Fork" targetRef="Timer_NextReminder" />
      <bpmn2:sequenceFlow id="S_Confirm_Mark" sourceRef="UserTask_ConfirmTrader" targetRef="ScriptTask_MarkConfirmed" />
      <bpmn2:sequenceFlow id="S_Mark_End" sourceRef="ScriptTask_MarkConfirmed" targetRef="End_TermConfirmed" />
      <bpmn2:sequenceFlow id="S_Timer_Count" sourceRef="Timer_NextReminder" targetRef="ScriptTask_Count" />
      <bpmn2:sequenceFlow id="S_Count_GwMore" sourceRef="ScriptTask_Count" targetRef="Gateway_More" />
      <bpmn2:sequenceFlow id="S_GwMore_Reminder" name="Oui" sourceRef="Gateway_More" targetRef="ScriptTask_SendReminder">
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${reminderCount &lt; maxDays}</bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
      <bpmn2:sequenceFlow id="S_GwMore_Final" name="Non" sourceRef="Gateway_More" targetRef="ScriptTask_SendFinal" />
      <bpmn2:sequenceFlow id="S_Reminder_Timer" sourceRef="ScriptTask_SendReminder" targetRef="Timer_NextReminder" />
      <bpmn2:sequenceFlow id="S_Final_End" sourceRef="ScriptTask_SendFinal" targetRef="End_TermExpired" />
    </bpmn2:subProcess>

    <bpmn2:serviceTask id="ServiceTask_StatusFinal" name="API : statut final (COMPLETED / EXPIRED)" camunda:asyncBefore="true">
      <bpmn2:documentation>Optionnel : supprimer cette tâche si le service externe ne doit pas être notifié en fin de workflow.</bpmn2:documentation>
      <bpmn2:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">${apiBaseUrl}/requests/${idRequest}/status</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{"idRequest":"${idRequest}","status":"${outcome}"}</camunda:inputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Sub_StatusFinal</bpmn2:incoming>
      <bpmn2:outgoing>Flow_StatusFinal_GwOutcome</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:exclusiveGateway id="Gateway_Outcome" name="Résultat ?" default="Flow_Outcome_Expired">
      <bpmn2:incoming>Flow_StatusFinal_GwOutcome</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Outcome_Completed</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Outcome_Expired</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:endEvent id="End_Completed" name="Completed">
      <bpmn2:incoming>Flow_Outcome_Completed</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="End_Expired" name="Expired (recréer la demande)">
      <bpmn2:incoming>Flow_Outcome_Expired</bpmn2:incoming>
    </bpmn2:endEvent>

    <!-- ===================== FLUX PRINCIPAL ===================== -->
    <bpmn2:sequenceFlow id="Flow_Start_Market" sourceRef="StartEvent_Request" targetRef="Gateway_Market" />
    <bpmn2:sequenceFlow id="Flow_Market_M4" name="4" sourceRef="Gateway_Market" targetRef="ScriptTask_EmailTeam_M4">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${marketId == '4'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Market_M948" name="948" sourceRef="Gateway_Market" targetRef="ScriptTask_EmailTeam_M948">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${marketId == '948'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Market_Unsupported" name="Autre" sourceRef="Gateway_Market" targetRef="End_UnsupportedMarket" />

    <!-- Chemin marché 4 -->
    <bpmn2:sequenceFlow id="Flow_EmailM4_Task" sourceRef="ScriptTask_EmailTeam_M4" targetRef="UserTask_TraiterDemande_M4" />
    <bpmn2:sequenceFlow id="Flow_TaskM4_Confirm" sourceRef="UserTask_TraiterDemande_M4" targetRef="Gateway_Confirm_M4" />
    <bpmn2:sequenceFlow id="Flow_ConfirmM4_Yes" name="Oui" sourceRef="Gateway_Confirm_M4" targetRef="Gateway_Merge">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${execution.hasVariable('confirmOnBehalf') &amp;&amp; confirmOnBehalf == true}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_ConfirmM4_No" name="Non" sourceRef="Gateway_Confirm_M4" targetRef="UserTask_TraiterDemande_M4" />

    <!-- Chemin marché 948 -->
    <bpmn2:sequenceFlow id="Flow_EmailM948_Task" sourceRef="ScriptTask_EmailTeam_M948" targetRef="UserTask_TraiterDemande_M948" />
    <bpmn2:sequenceFlow id="Flow_TaskM948_Confirm" sourceRef="UserTask_TraiterDemande_M948" targetRef="Gateway_Confirm_M948" />
    <bpmn2:sequenceFlow id="Flow_ConfirmM948_Yes" name="Oui" sourceRef="Gateway_Confirm_M948" targetRef="Gateway_Merge">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${execution.hasVariable('confirmOnBehalf') &amp;&amp; confirmOnBehalf == true}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_ConfirmM948_No" name="Non" sourceRef="Gateway_Confirm_M948" targetRef="UserTask_TraiterDemande_M948" />

    <!-- Suite commune -->
    <bpmn2:sequenceFlow id="Flow_Merge_Status" sourceRef="Gateway_Merge" targetRef="ServiceTask_StatusWaitingTrader" />
    <bpmn2:sequenceFlow id="Flow_Status_EmailTrader" sourceRef="ServiceTask_StatusWaitingTrader" targetRef="ScriptTask_EmailTrader" />
    <bpmn2:sequenceFlow id="Flow_EmailTrader_Sub" sourceRef="ScriptTask_EmailTrader" targetRef="SubProcess_AttenteTrader" />
    <bpmn2:sequenceFlow id="Flow_Sub_StatusFinal" sourceRef="SubProcess_AttenteTrader" targetRef="ServiceTask_StatusFinal" />
    <bpmn2:sequenceFlow id="Flow_StatusFinal_GwOutcome" sourceRef="ServiceTask_StatusFinal" targetRef="Gateway_Outcome" />
    <bpmn2:sequenceFlow id="Flow_Outcome_Completed" name="COMPLETED" sourceRef="Gateway_Outcome" targetRef="End_Completed">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${outcome == 'COMPLETED'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Outcome_Expired" name="EXPIRED" sourceRef="Gateway_Outcome" targetRef="End_Expired" />
  </bpmn2:process>

